# 🔑 OpenAI APIキー
OPENAI_API_KEY=your-openai-api-key

# 🔐 Google Cloud サービスアカウント認証情報（base64でエンコード）
GOOGLE_CREDENTIALS_BASE64=your-base64-encoded-json

# 📄 Google スプレッドシートのID
SPREADSHEET_ID=your-google-sheet-id

# 追加許可するOriginがある場合はカンマ区切りで指定（未設定時は公式UIのみ）
ALLOWED_ORIGINS=https://chatbot-re.psi-coffee.com
